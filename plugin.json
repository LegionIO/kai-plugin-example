{
  "name": "example",
  "displayName": "Example Plugin",
  "version": "1.0.4",
  "description": "A template plugin demonstrating backend tools, frontend UI, and shared state",
  "icon": {
    "lucide": "puzzle"
  },
  "author": "John Hollow <https://github.com/iamhollow>",
  "permissions": [
    "config:read",
    "config:write",
    "state:publish",
    "tools:register",
    "ui:panel",
    "ui:navigation",
    "ui:settings"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "greeting": {
        "type": "string",
        "default": "Hello"
      },
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "showGreeting": {
        "type": "boolean",
        "default": true
      }
    }
  }
}
